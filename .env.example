# Copy this file to .env and fill in real values. Never commit .env itself.
#
# Postgres for Prisma — needs TWO connection strings (see docs/ENVIRONMENT.md
# and docs/ARCHITECTURE.md "Hosting: cloud Postgres free tier"):
#   DATABASE_URL — pooled connection, used by the app at runtime
#   DIRECT_URL   — direct/unpooled connection, used only by `prisma migrate`
#
# Neon shape (pooled host has "-pooler" in it; direct host doesn't):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
#
# Supabase shape (pooled = port 6543 with pgbouncer=true, direct = port 5432):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DATABASE_URL=
DIRECT_URL=

# Auth.js (NextAuth v5) session secret -- signs/encrypts the JWT session
# cookie for the email+password login (see docs/ARCHITECTURE.md "User
# management and per-word overrides"). Generate one with:
#   openssl rand -base64 32
# Required in production; falls back to an insecure dev default only
# when NODE_ENV=development and this is unset -- always set it for
# anything beyond your own machine.
AUTH_SECRET=

# GitHub Release asset URL for the bulk dictionary seed file (see
# src/lib/dictionaryDb.ts) -- not needed in local dev if
# data/seed/dictionary_seed.db is already checked out there (built via
# data/seed/build_dictionary.py), only for a deployment that isn't. A
# `.gz`-suffixed URL is decompressed transparently on download.
DICTIONARY_DB_URL=

# Public site origin (no trailing slash), used by src/app/sitemap.ts and
# src/app/robots.ts to build absolute URLs. Optional -- falls back to the
# production Vercel URL if unset, so only needed for a different domain.
NEXT_PUBLIC_SITE_URL=
