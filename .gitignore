# Vendor reference clones used to build the seed dictionary — ~375 MB,
# reproducible via the `git clone` commands in docs/DICTIONARY_SOURCES.md.
ref/

# Bulk dictionary seed (~216 MB) — too large for a normal git push and
# not committed via Git LFS (Vercel doesn't resolve LFS pointers). Built
# locally via data/seed/build_dictionary.py, or downloaded automatically
# at runtime from a GitHub Release asset — see src/lib/dictionaryDb.ts.
data/seed/dictionary_seed.db

# Python
__pycache__/
*.pyc

# Node / Next.js
node_modules/
.claude/
.next/
out/
dist/
build/
npm-debug.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# Prisma
prisma/migrations/dev.db*

# Env & secrets — never commit real credentials
.env
.env.*
!.env.example

# OS junk
.DS_Store
Thumbs.db
*.pem

# Editors
.vscode/
.idea/

# Test coverage
/coverage