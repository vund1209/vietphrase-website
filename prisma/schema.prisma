// Live application schema for the VietPhrase translation site.
//
// Design pivot (2026-09-05): the bulk, read-only dictionaries (Word,
// Pronoun, HanvietFallback, ScrapeBlacklistPattern) do NOT live here
// anymore -- they stay in data/seed/dictionary_seed.db, shipped
// read-only alongside the app and loaded by packages/tokenizer directly.
// Reason: that SQLite file is ~226 MB on disk (words alone is ~132 MB
// across 1.43M rows, names ~30 MB across 276k rows) -- duplicating that
// into Postgres would consume most or all of a free-tier Postgres
// storage budget (Neon free tier: 0.5 GB total) before a single real
// chapter of novel content is stored. It's also genuinely static data:
// rebuilt from source via data/seed/build_dictionary.py, never edited
// row-by-row through the app. There's no reason to pay Postgres storage
// and query-latency cost for data that's already fast to read locally
// from a bundled SQLite file.
//
// What Postgres actually holds is exactly the live, mutable application
// state: which novels/chapters exist, their scrape/translate status and
// cached text, and per-novel Name overrides that users actually curate
// over time (starts empty, grows slowly -- nothing like the bulk seed
// size). See docs/ARCHITECTURE.md ("Data access: avoid per-lookup DB
// round-trips" and "Hosting: cloud Postgres free tier") for the full
// reasoning and how the tokenizer combines both sources at request time.
//
// This replaces the earlier design (see git history prior to this
// commit) where Word/Pronoun/HanvietFallback/ScrapeBlacklistPattern were
// modeled here too, with a reserved "global" Novel row standing in for
// Prisma's inability to express a partial-unique-index nullable scope.
// That sentinel-row trick is no longer needed: since global/fallback
// names now live in the SQLite seed file, every `Name` row in Postgres
// is a real per-novel override with a required `novelId` -- there's no
// "global" case to represent here at all.
//
// Design notes worth knowing before you touch this file:
//
// - `Name` is the only dictionary-shaped table here, and it's genuinely
//   live: it's what a per-novel override editing feature would write to.
//   `novelId` is required -- a Name row with no specific novel doesn't
//   exist in Postgres; that case is served from the SQLite seed instead.
// - `Chapter.rawText`/`translatedText` are nullable because scraping is
//   lazy (see docs/ARCHITECTURE.md "Scrape timing"): a chapter can exist
//   -- known from the chapter list -- before it's ever been fetched.
//   `status` tracks where in that lifecycle a given chapter is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer/Supavisor) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate`/`db push`.
  // Same host as DATABASE_URL minus the pooler, per docs/ENVIRONMENT.md.
  directUrl = env("DIRECT_URL")
}

/// Every novel/story being translated. Also the scope for per-novel Name
/// overrides (see Name below) -- a book's chapters and its name
/// overrides belong to the same entity, so this does double duty rather
/// than being split into two tables.
model Novel {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  title         String
  author        String?
  sourceUrl     String?
  coverImageUrl String?
  status        NovelStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  names    Name[]
  chapters Chapter[]

  @@map("novels")
}

enum NovelStatus {
  PENDING // chapter list not yet fetched
  READY // chapter list fetched; chapters fill in lazily as they're viewed
  ERROR // chapter list fetch failed
}

/// One chapter of a Novel. Rows are created for every chapter as soon as
/// the chapter list is fetched (status PENDING), but `rawText` /
/// `translatedText` stay null until that specific chapter is scraped and
/// translated -- lazily, on first view. See docs/ARCHITECTURE.md
/// "Scrape timing" for why this is lazy rather than eager.
model Chapter {
  id             Int           @id @default(autoincrement())
  novelId        Int
  novel          Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapterNumber  Int
  title          String
  sourceUrl      String
  rawText        String? // Chinese; null until first scraped
  translatedText String? // Vietnamese; null until first translated
  status         ChapterStatus @default(PENDING)
  scrapedAt      DateTime?
  translatedAt   DateTime?
  createdAt      DateTime      @default(now())

  @@unique([novelId, chapterNumber])
  @@index([novelId])
  @@map("chapters")
}

enum ChapterStatus {
  PENDING // known from the chapter list, not yet scraped
  SCRAPED // raw text fetched, not yet translated
  TRANSLATED // ready to read
  ERROR // scrape or translation failed
}

/// Per-novel proper-noun overrides -- the dictionary users actually
/// curate over time, one novel at a time. Checked before the SQLite
/// seed's global names/pronouns/words during tokenization (see
/// docs/VIETPHRASE_CORE.md). Starts empty for every novel; there is no
/// bulk import into this table.
model Name {
  id             Int      @id @default(autoincrement())
  chineseText    String
  vietnameseText String
  phraseLength   Int
  novelId        Int
  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  source         String
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chineseText, novelId])
  @@index([phraseLength])
  @@index([novelId])
  @@map("names")
}
