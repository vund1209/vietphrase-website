// Live application schema for the VietPhrase translation site.
//
// Design pivot (2026-09-05): the bulk, read-only dictionaries (Word,
// Pronoun, HanvietFallback, ScrapeBlacklistPattern) do NOT live here
// anymore -- they stay in data/seed/dictionary_seed.db, shipped
// read-only alongside the app and loaded by packages/tokenizer directly.
// Reason: that SQLite file is ~226 MB on disk (words alone is ~132 MB
// across 1.43M rows, names ~30 MB across 276k rows) -- duplicating that
// into Postgres would consume most or all of a free-tier Postgres
// storage budget (Neon free tier: 0.5 GB total) before a single real
// chapter of novel content is stored. It's also genuinely static data:
// rebuilt from source via data/seed/build_dictionary.py, never edited
// row-by-row through the app. There's no reason to pay Postgres storage
// and query-latency cost for data that's already fast to read locally
// from a bundled SQLite file.
//
// What Postgres actually holds is exactly the live, mutable application
// state: which novels/chapters exist, their scrape/translate status and
// cached text, and per-novel Name overrides that users actually curate
// over time (starts empty, grows slowly -- nothing like the bulk seed
// size). See docs/ARCHITECTURE.md ("Data access: avoid per-lookup DB
// round-trips" and "Hosting: cloud Postgres free tier") for the full
// reasoning and how the tokenizer combines both sources at request time.
//
// This replaces the earlier design (see git history prior to this
// commit) where Word/Pronoun/HanvietFallback/ScrapeBlacklistPattern were
// modeled here too, with a reserved "global" Novel row standing in for
// Prisma's inability to express a partial-unique-index nullable scope.
// That sentinel-row trick is no longer needed: since global/fallback
// names now live in the SQLite seed file, every `Name` row in Postgres
// is a real per-novel override with a required `novelId` -- there's no
// "global" case to represent here at all.
//
// Design notes worth knowing before you touch this file:
//
// - `Name` is the only dictionary-shaped table here, and it's genuinely
//   live: it's what a per-novel override editing feature would write to.
//   `novelId` is required -- a Name row with no specific novel doesn't
//   exist in Postgres; that case is served from the SQLite seed instead.
// - `Chapter.rawText`/`translatedText` are nullable because scraping is
//   lazy (see docs/ARCHITECTURE.md "Scrape timing"): a chapter can exist
//   -- known from the chapter list -- before it's ever been fetched.
//   `status` tracks where in that lifecycle a given chapter is.

generator client {
  provider = "prisma-client-js"
  // "native" covers the real Windows dev machine (see docs/ENVIRONMENT.md);
  // "debian-openssl-3.0.x" additionally covers the bridged Linux dev
  // environment Claude Code Remote uses, so the generated client works
  // from both without needing a separate generate step per environment.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer/Supavisor) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate`/`db push`.
  // Same host as DATABASE_URL minus the pooler, per docs/ENVIRONMENT.md.
  directUrl = env("DIRECT_URL")
}

/// Every novel/story being translated. Also the scope for per-novel Name
/// overrides (see Name below) -- a book's chapters and its name
/// overrides belong to the same entity, so this does double duty rather
/// than being split into two tables.
model Novel {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  title         String
  // Raw scraped title (source language), preserved so the translated
  // `title` above can be recomputed later (e.g. after a dictionary
  // promotion) without re-scraping. Null for novels added before this
  // column existed.
  originalTitle String?
  // Translated (Vietnamese) description -- see originalTitle above for
  // why the raw/translated split exists. Searchable alongside title.
  description   String?
  originalDescription String?
  author        String?
  sourceUrl     String?
  coverImageUrl String?
  status        NovelStatus @default(PENDING)
  // Admin-set only (null = unknown) -- unlike description/cover/author,
  // there's no reliable generic <meta> signal for this across arbitrary
  // sites, so it's not auto-scraped.
  completionStatus NovelCompletionStatus?
  createdAt     DateTime    @default(now())
  // SCRAPED (default): embedded from a source URL, admin-managed.
  // USER_CREATED: authored in this system (manual chapters and/or .txt
  // import), owner-managed -- see the planning doc's section 8.
  origin        NovelOrigin @default(SCRAPED)
  // Who embedded this novel -- null for rows added before embedding
  // required login, or if that account is later deleted (SetNull, same
  // pattern as Name.promotedByUserId: losing track of who added a book
  // isn't worth cascading its deletion). See the planning doc's section 5
  // ("embedding requires login") and section 6 (clickable "Thêm bởi").
  // For a USER_CREATED novel, this doubles as *ownership*, not just
  // attribution -- see src/lib/isOwnerOrAdmin.ts.
  addedByUserId Int?
  addedByUser   User?       @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  // Real, incrementally-tracked chapter-view count -- not a placeholder.
  // Incremented once per chapter view (src/lib/novels.ts's
  // getOrTranslateChapter). See the planning doc's section 12
  // ("engagement stats... once there's something real to show").
  viewCount     Int         @default(0)

  names               Name[]
  novelWordOverrides  NovelWordOverride[]
  chapters            Chapter[]
  userWordOverrides   UserWordOverride[]
  userNameOverrides   UserNameOverride[]
  readingProgress     ReadingProgress[]
  tags                NovelTag[]

  @@index([addedByUserId])
  // Real filter columns in src/lib/novelBrowse.ts's buildNovelWhere:
  // sourceUrl (startsWith -- a B-tree index serves a prefix match) and
  // completionStatus/author (equality). title/description deliberately
  // NOT indexed here despite also being filter columns -- they're
  // matched with `contains` (arbitrary substring), which a plain B-tree
  // index can't accelerate at all (would need pg_trgm/GIN or full-text
  // search instead); adding one would just be index-maintenance cost on
  // every write for zero query benefit.
  @@index([sourceUrl])
  @@index([completionStatus])
  @@index([author])
  @@map("novels")
}

enum NovelCompletionStatus {
  ONGOING
  COMPLETED
}

/// See the planning doc's section 8.
enum NovelOrigin {
  SCRAPED
  USER_CREATED
}

enum NovelStatus {
  PENDING // chapter list not yet fetched
  READY // chapter list fetched; chapters fill in lazily as they're viewed
  ERROR // chapter list fetch failed
}

/// One chapter of a Novel. Rows are created for every chapter as soon as
/// the chapter list is fetched (status PENDING), but `rawText` stays
/// null until that specific chapter is scraped -- lazily, on first view.
/// See docs/ARCHITECTURE.md "Scrape timing" for why this is lazy rather
/// than eager. There is deliberately no stored translated copy: VietPhrase
/// translation is a render-time layer over `rawText` (see
/// src/lib/novels.ts's getOrTranslateChapter), not a separately cached
/// value -- this is the actual VietPhrase-tool model, and it means a
/// dictionary change takes effect on the next view with no invalidation
/// step at all.
model Chapter {
  id             Int           @id @default(autoincrement())
  novelId        Int
  novel          Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapterNumber  Int
  title          String
  // Raw scraped chapter title, same reasoning as Novel.originalTitle.
  originalTitle  String?
  // Best-effort chapter ID parsed from the tail of `sourceUrl` (e.g. the
  // source site's own chapter ID). Reference/dedup only -- chapterNumber
  // remains the sequential index this app routes on.
  sourceChapterId String?
  // Null for a manually-entered or .txt-imported chapter of a
  // USER_CREATED novel -- there's no source page to point back to. See
  // the planning doc's section 8.
  sourceUrl      String?
  rawText        String? // null until first scraped (SCRAPED) or always populated at creation (USER_CREATED)
  status         ChapterStatus @default(PENDING)
  scrapedAt      DateTime?
  createdAt      DateTime      @default(now())
  // Whether `rawText` is Chinese (translate as usual) or already
  // Vietnamese (a USER_CREATED chapter can be either) -- decides whether
  // getOrTranslateChapter runs the VietPhrase pipeline at all. See the
  // planning doc's section 8.
  sourceLanguage SourceLanguage @default(ZH)

  @@unique([novelId, chapterNumber])
  @@index([novelId])
  @@map("chapters")
}

enum SourceLanguage {
  ZH
  VI
}

enum ChapterStatus {
  PENDING // known from the chapter list, not yet scraped
  SCRAPED // raw text fetched -- ready to render (translation is always live)
  ERROR // scrape failed
}

/// Per-novel proper-noun overrides (the NAME track of the per-novel tier
/// -- see NovelWordOverride for its PHRASE-track counterpart; the two
/// used to be conflated in this one table until that split). The
/// dictionary users actually curate over time, one novel at a time.
/// Checked before the SQLite seed's global names/pronouns/words during
/// tokenization (see docs/VIETPHRASE_CORE.md). Starts empty for every
/// novel; there is no bulk import into this table.
model Name {
  id             Int      @id @default(autoincrement())
  chineseText    String
  vietnameseText String
  // How this entry's vietnameseText renders regardless of sentence
  // position -- e.g. a person's full name should always read fully
  // capitalized, not just when it happens to start a sentence. See
  // src/lib/tokenizer.ts's applyCapStyle.
  capStyle       NameCapStyle @default(NONE)
  phraseLength   Int
  novelId        Int
  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  source         String
  isActive       Boolean  @default(true)
  createdById    String?
  // Set when this shared entry originated from an editor promoting a
  // reader's private UserWordOverride (see UserWordOverride below) --
  // null for rows seeded some other way (e.g. a future bulk import).
  // Deliberately SetNull on delete: losing track of who promoted an
  // entry isn't worth cascading the deletion of the shared translation
  // itself if that editor's account is later removed.
  promotedByUserId Int?
  promotedByUser   User?    @relation(fields: [promotedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chineseText, novelId])
  @@index([phraseLength])
  @@index([novelId])
  @@map("names")
}

enum NameCapStyle {
  NONE // no forced capitalization -- sentence-position rules still apply
  FIRST_LETTER // capitalize just the first letter of the whole phrase
  ALL_WORDS // capitalize the first letter of every word (full proper names)
}

/// Per-novel PHRASE-track overrides -- the counterpart split out of `Name`
/// (which stays the per-novel NAME track). A phrase correction ("this verb
/// reads better as X in this novel") and a proper-noun override ("this
/// character's name is X") used to write to the same table with no way to
/// tell them apart later; this table exists so the promotion/management
/// UI (see /admin, /novels/[slug]/overrides) can treat them separately
/// while translation itself still merges both (src/lib/overrides.ts).
/// Field-for-field identical to `Name` by design -- same shape, different
/// track.
model NovelWordOverride {
  id             Int      @id @default(autoincrement())
  chineseText    String
  vietnameseText String
  capStyle       NameCapStyle @default(NONE)
  phraseLength   Int
  novelId        Int
  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  source         String
  isActive       Boolean  @default(true)
  // See Name.promotedByUserId above -- same meaning, phrase-track copy.
  promotedByUserId Int?
  promotedByUser   User?    @relation(fields: [promotedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chineseText, novelId])
  @@index([phraseLength])
  @@index([novelId])
  @@map("novel_word_overrides")
}

/// Admin-curated corrections that apply across EVERY novel -- unlike
/// `Name` (scoped to one novel) or `UserWordOverride` (scoped to one
/// reader, one novel), there was previously no way to fix a translation
/// once and have it apply everywhere. Checked with lower priority than
/// per-novel `Name` (which in turn loses to a reader's own
/// `UserWordOverride`) -- see src/lib/overrides.ts's merge order. Still
/// doesn't duplicate the bulk SQLite dictionary: like `Name`, this stays
/// a small, sparse table of corrections, not a copy of the ~226MB seed
/// data. See docs/PLANNED_FEATURES.md.
model GlobalWordOverride {
  id             Int          @id @default(autoincrement())
  chineseText    String       @unique
  vietnameseText String
  capStyle       NameCapStyle @default(NONE)
  phraseLength   Int
  source         String
  isActive       Boolean      @default(true)
  createdById    Int?
  createdByUser  User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([phraseLength])
  @@map("global_word_overrides")
}

/// Admin-curated NAME-track corrections that apply across every novel --
/// the counterpart split out of `GlobalWordOverride` (which stays the
/// global PHRASE track), same reasoning as `NovelWordOverride`/`Name`
/// above. Field-for-field identical to `GlobalWordOverride`.
model GlobalNameOverride {
  id             Int          @id @default(autoincrement())
  chineseText    String       @unique
  vietnameseText String
  capStyle       NameCapStyle @default(NONE)
  phraseLength   Int
  source         String
  isActive       Boolean      @default(true)
  createdById    Int?
  createdByUser  User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([phraseLength])
  @@map("global_name_overrides")
}

/// A registered reader/editor account. Credentials auth only (email +
/// bcrypt-hashed password) -- see docs/ARCHITECTURE.md "User management
/// and per-word overrides" for why: this is a small, trusted-editor
/// product, not a public sign-up funnel, so there's no OAuth provider
/// wiring to maintain.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  // READER: can save private word overrides for any novel, visible only
  // to themselves. EDITOR: can additionally promote a private override
  // (theirs or another reader's) into the shared Name dictionary that
  // every reader of that novel sees. There is no self-service upgrade
  // path from READER to EDITOR -- an existing EDITOR (or direct DB
  // access) has to grant it. See docs/ARCHITECTURE.md.
  role         UserRole @default(READER)
  createdAt    DateTime @default(now())

  wordOverrides UserWordOverride[]
  nameOverrides UserNameOverride[]
  // Reverse side of Name.promotedByUser above -- no explicit @relation
  // needed since Name<->User has only one FK linking them.
  promotedNames Name[]
  // Reverse side of NovelWordOverride.promotedByUser above.
  promotedNovelWordOverrides NovelWordOverride[]
  readingProgress ReadingProgress[]
  // Reverse side of GlobalWordOverride.createdByUser above.
  globalWordOverrides GlobalWordOverride[]
  // Reverse side of GlobalNameOverride.createdByUser above.
  globalNameOverrides GlobalNameOverride[]
  // Reverse side of Novel.addedByUser above.
  addedNovels Novel[]
  activityLog AdminActivityLog[]
  // Reverse side of NovelTag.addedByUser below.
  addedNovelTags NovelTag[]

  @@map("users")
}

enum UserRole {
  READER
  EDITOR
  // Superset of EDITOR (inherits shared-dictionary promotion rights) --
  // the only role that can delete a novel from the library. No
  // self-service upgrade path; see scripts/set-user-role.mjs.
  ADMIN
}

/// A reader's *private* word/phrase override for one novel -- visible
/// only to that reader, never shared, until (if ever) an EDITOR
/// promotes it into the novel's shared Name dictionary. This is what
/// makes "click a word, fix its translation" safe to expose to every
/// registered reader without risking vandalism of what everyone else
/// sees: see docs/ARCHITECTURE.md "User management and per-word
/// overrides" for the full reasoning (this table exists specifically
/// because letting every reader edit the shared Name table directly
/// was the rejected alternative).
model UserWordOverride {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId        Int
  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chineseText    String
  vietnameseText String
  // See Name.capStyle above -- same meaning, personal-scope copy.
  capStyle       NameCapStyle @default(NONE)
  phraseLength   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, novelId, chineseText])
  @@index([novelId, phraseLength])
  @@map("user_word_overrides")
}

/// A reader's *private* NAME-track override for one novel -- the
/// counterpart split out of `UserWordOverride` (which stays the personal
/// PHRASE track), same reasoning as `NovelWordOverride`/`Name` and
/// `GlobalNameOverride`/`GlobalWordOverride` above. Field-for-field
/// identical to `UserWordOverride`.
model UserNameOverride {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId        Int
  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chineseText    String
  vietnameseText String
  capStyle       NameCapStyle @default(NONE)
  phraseLength   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, novelId, chineseText])
  @@index([novelId, phraseLength])
  @@map("user_name_overrides")
}

/// A signed-in reader's "continue reading" position for one novel. Only
/// ever exists for an account -- an anonymous reader's progress lives
/// entirely client-side (IndexedDB, see src/lib/clientSync.ts) and never
/// reaches Postgres at all. Used to key on an opaque cookie-based
/// `readerId` instead (no account tie at all); that approach silently
/// lost progress on every "clear cookies" or new-device visit, which is
/// exactly what this schema change fixes -- see the planning doc's
/// section 4.
model ReadingProgress {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId       Int
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapterNumber Int
  updatedAt     DateTime @updatedAt

  @@unique([userId, novelId])
  @@index([userId])
  @@map("reading_progress")
}

/// Curated preset taxonomy for novel classification -- see the planning
/// doc's section 13. Deliberately closed-vocabulary: a reader picks from
/// this list via NovelTag, never creates a Tag row themselves (seeded by
/// prisma/seed-tags.ts) -- keeps the taxonomy consistent and searchable
/// instead of free-form tag sprawl.
model Tag {
  id       Int    @id @default(autoincrement())
  name     String // Vietnamese display text, e.g. "Xuyên không"
  slug     String @unique
  // "Thể loại" (genre) vs "Yếu tố" (trope/element) -- matches how
  // eirlystravailai.top itself separates these. Null = uncategorized.
  category String?

  novels NovelTag[]

  @@map("tags")
}

/// Many-to-many join between Novel and Tag. Any logged-in reader may add
/// an existing preset Tag to any novel -- low risk, since they can only
/// pick from the fixed Tag vocabulary, never invent one -- but removing
/// one requires being the reader who added it, or an admin (prevents
/// griefing). See the planning doc's section 13; addedByUserId doubles as
/// the authorization check for removal, same pattern as
/// Novel.addedByUserId/src/lib/isOwnerOrAdmin.ts.
model NovelTag {
  id            Int      @id @default(autoincrement())
  novelId       Int
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  tagId         Int
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  // Null if that account is later deleted (SetNull, same pattern as
  // Novel.addedByUserId) -- losing track of who tagged a novel isn't
  // worth cascading the tag's removal.
  addedByUserId Int?
  addedByUser   User?    @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([novelId, tagId])
  @@index([tagId])
  @@map("novel_tags")
}

/// Lightweight Postgres-backed rate limiter (see src/lib/rateLimit.ts) --
/// no external service (Upstash/Redis) added for what's a modest request
/// volume; this reuses the existing Neon DB. One row per (bucket, ipHash,
/// windowStart); a request increments the current window's count and is
/// rejected once it exceeds the caller's configured max. `ipHash` is a
/// hash, never the raw IP -- this table exists purely to throttle abuse,
/// not to identify visitors. See the planning doc's section 5.
model RateLimitBucket {
  id          Int      @id @default(autoincrement())
  // Scopes independent limits -- e.g. "surf" is shared by both /api/surf
  // and /surf/browse so switching between them doesn't bypass the limit.
  bucket      String
  ipHash      String
  windowStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([bucket, ipHash, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Audit trail for admin/embed actions -- who did what, when. `userId` is
/// nullable to also cover rate-limit denials, which can come from an
/// anonymous request with no account at all. `targetType`/`targetId` are
/// a loose (not FK-constrained) reference -- deliberately: a log entry
/// should survive its target being deleted (e.g. "novel.delete" itself),
/// so this can never be a real foreign key. See the planning doc's
/// section 5 and src/lib/adminActivity.ts.
model AdminActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("admin_activity_log")
}

/// Single-row counter bumped whenever any *shared* dictionary tier
/// changes (NovelWordOverride/Name promotion, GlobalWordOverride/
/// GlobalNameOverride add or deactivate). Personal overrides
/// (UserWordOverride/UserNameOverride) deliberately do NOT bump this --
/// they're applied client-side only (see the planning doc's section 3)
/// and never affect what src/lib/overrides.ts's loadOverridesForNovel
/// returns, so bumping on every personal save would invalidate every
/// reader's cache for no reason. See src/lib/dictionaryVersion.ts and
/// the planning doc's section 9 (chapter-translation caching without
/// reintroducing staleness).
model DictionaryVersion {
  id      Int @id
  version Int @default(1)

  @@map("dictionary_version")
}
